# PlantDB API — Production Environment Template (Laravel Cloud)
#
# Setup: Laravel Cloud → Environment Variables. Values marked `# set via Cloud`
# must be entered manually in the Cloud UI (never commit real secrets!).
# Values marked `# auto` are injected automatically by Laravel Cloud
# (Postgres addon, Object Storage) and don't need to be set by hand.
#
# Local dev uses .env / .env.example — this file is documentation for prod.

APP_NAME="PlantDB API"
APP_ENV=production
APP_KEY=                          # set via Cloud: `php artisan key:generate --show`
APP_DEBUG=false
APP_URL=https://plantdb.dev
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log: daily rotation + Sentry
LOG_CHANNEL=production
LOG_STACK=daily,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# PostgreSQL — provided by Laravel Cloud Postgres addon
DB_CONNECTION=pgsql
DB_HOST=                          # auto (from Cloud Postgres)
DB_PORT=5432                      # auto
DB_DATABASE=                      # auto
DB_USERNAME=                      # auto
DB_PASSWORD=                      # auto

# First admin user (seeded once, rotate password afterwards)
ADMIN_EMAIL=chrisganzert@gmail.com
ADMIN_PASSWORD=                   # set via Cloud

# Sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.plantdb.dev
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=media
QUEUE_CONNECTION=database         # Redis migration = follow-up

CACHE_STORE=database              # Redis migration = follow-up

# Mail — Mailgun EU region via Symfony transport
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=noreply@plantdb.dev
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=chrisganzert@gmail.com

MAILGUN_DOMAIN=plantdb.dev
MAILGUN_SECRET=                   # set via Cloud (Mailgun → Sending API Key)
MAILGUN_ENDPOINT=api.eu.mailgun.net
MAILGUN_SCHEME=https

# Object Storage — Laravel Cloud (S3-compatible, eu-central-1)
# Two buckets: one public (media), one private (backups).
MEDIA_DISK=media
BACKUP_DISKS=backups

AWS_ACCESS_KEY_ID=                # set via Cloud (Object Storage credentials)
AWS_SECRET_ACCESS_KEY=            # set via Cloud
AWS_DEFAULT_REGION=eu-central-1
AWS_ENDPOINT=                     # set via Cloud (Object Storage endpoint URL)
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_BUCKET=plantdb-media
MEDIA_URL=                        # set via Cloud (public bucket URL / CDN)
BACKUP_BUCKET=plantdb-backups

# Sentry (DSN from Sentry project "plantdb-api")
SENTRY_LARAVEL_DSN=               # set via Cloud
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Backups (spatie/laravel-backup) — daily 02:00, cleanup 01:00
BACKUP_ARCHIVE_PASSWORD=          # set via Cloud (openssl rand -base64 32)
BACKUP_NOTIFICATION_MAIL_TO=chrisganzert@gmail.com

VITE_APP_NAME="${APP_NAME}"
