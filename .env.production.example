# PlantDB API — Production Environment Template
#
# Nutzung: In Forge → Site → Environment. Werte mit `# set via Forge` müssen
# in Forge einzeln gesetzt werden (nicht committen!). Beispiel: DB_PASSWORD.
#
# Nach dem Ausfüllen: `php artisan config:cache` (macht deploy.sh automatisch).

APP_NAME="PlantDB API"
APP_ENV=production
APP_KEY=                       # set via Forge (`php artisan key:generate --show`)
APP_DEBUG=false
APP_URL=https://plantdb.example
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log: daily-Rotation + Sentry
LOG_CHANNEL=production
LOG_STACK=daily,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# PostgreSQL — Managed oder self-hosted; Zugang via Forge → Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=plantdb_api
DB_USERNAME=plantdb             # set via Forge
DB_PASSWORD=                    # set via Forge

# Erster Admin-User beim Seed (kann nach Setup gelöscht/rotiert werden)
ADMIN_EMAIL=chrisganzert@gmail.com
ADMIN_PASSWORD=                 # set via Forge

# Sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.plantdb.example
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database       # Redis-Migration = Follow-up

CACHE_STORE=database            # Redis-Migration = Follow-up

# Mail (Beispiel Postmark oder Amazon SES; genauer Wert via Forge)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=                      # set via Forge
MAIL_PORT=587
MAIL_USERNAME=                  # set via Forge
MAIL_PASSWORD=                  # set via Forge
MAIL_FROM_ADDRESS=noreply@plantdb.example
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=chrisganzert@gmail.com

# Media-Storage (Cloudflare R2, S3-kompatibel)
MEDIA_DISK=r2

R2_ACCESS_KEY_ID=               # set via Forge
R2_SECRET_ACCESS_KEY=           # set via Forge
R2_DEFAULT_REGION=auto
R2_BUCKET=plantdb-prod-media
R2_BACKUPS_BUCKET=plantdb-prod-backups
R2_ENDPOINT=                    # set via Forge (z.B. https://<accountid>.r2.cloudflarestorage.com)
R2_URL=                         # public CDN-URL falls verwendet

# Sentry (DSN aus Sentry-Projekt „plantdb-api")
SENTRY_LARAVEL_DSN=             # set via Forge
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Backups (spatie/laravel-backup) — täglich um 02:00, cleanup 01:00
# WICHTIG: r2_backups zeigt auf den privaten Backup-Bucket, NIE auf den Media-Bucket!
BACKUP_DISKS=r2_backups
BACKUP_ARCHIVE_PASSWORD=        # set via Forge (Zip-Verschlüsselung)
BACKUP_NOTIFICATION_MAIL_TO=chrisganzert@gmail.com

VITE_APP_NAME="${APP_NAME}"
