meta {
  name: list families
  type: http
  seq: 1
}

get {
  url: {{apiUrl}}/families
  auth: none
}

params:query {
  ~filter[name]:
  ~sort: name
  ~locale: de
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    if (Array.isArray(data) && data.length > 0 && data[0].id) {
      bru.setEnvVar("familyId", data[0].id);
    }
  }
}
