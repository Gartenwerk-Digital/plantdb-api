meta {
  name: list plants
  type: http
  seq: 1
}

get {
  url: {{apiUrl}}/plants
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~per_page: 20
  ~sort: -created_at
  ~locale: de
  ~filter[q]: rosa
  ~filter[life_cycle]: perennial
  ~filter[sun_requirement]: full_sun
  ~filter[soil_moisture]: moist
  ~filter[bloom_month]: 6
  ~filter[edible]: true
  ~filter[toxic_to_pets]: false
}
