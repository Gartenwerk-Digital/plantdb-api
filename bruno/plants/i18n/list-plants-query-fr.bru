meta {
  name: list plants (?locale=fr — error demo)
  type: http
  seq: 7
}

get {
  url: {{apiUrl}}/plants?locale=fr
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  locale: fr
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("returns { error: { code: unsupported_locale } }", function () {
    const body = res.getBody();
    expect(body.error.code).to.equal("unsupported_locale");
  });
}
