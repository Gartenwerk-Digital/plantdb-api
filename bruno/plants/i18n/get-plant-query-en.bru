meta {
  name: get plant (?locale=en)
  type: http
  seq: 11
}

get {
  url: {{apiUrl}}/plants/:slug?locale=en
  auth: none
}

params:path {
  slug: solanum-lycopersicum
}

params:query {
  locale: en
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Content-Language header echoes en", function () {
    expect(res.getHeader("content-language")).to.equal("en");
  });
}
