meta {
  name: get plant (Accept-Language: en)
  type: http
  seq: 9
}

get {
  url: {{apiUrl}}/plants/:slug
  auth: none
}

params:path {
  slug: solanum-lycopersicum
}

headers {
  Accept-Language: en
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Content-Language header echoes en", function () {
    expect(res.getHeader("content-language")).to.equal("en");
  });
}
