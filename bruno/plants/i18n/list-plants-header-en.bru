meta {
  name: list plants (Accept-Language: en)
  type: http
  seq: 4
}

get {
  url: {{apiUrl}}/plants
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept-Language: en
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Content-Language header echoes en", function () {
    expect(res.getHeader("content-language")).to.equal("en");
  });
}
