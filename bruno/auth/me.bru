meta {
  name: me
  type: http
  seq: 3
}

get {
  url: {{apiUrl}}/me
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns current user under data", function () {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data).to.have.property("email");
  });
}
