meta {
  name: register
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test User",
    "email": "test@example.com",
    "password": "password",
    "password_confirmation": "password"
  }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns { data: { user, token } } + meta.message", function () {
    const body = res.getBody();
    expect(body.data.user).to.have.property("email");
    expect(body.data.token).to.be.a("string");
    expect(body.meta).to.have.property("message");
  });
}
