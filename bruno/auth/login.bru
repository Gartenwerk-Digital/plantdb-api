meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{apiUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "chrisganzert@gmail.com",
    "password": "password"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().data.token);
  }
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns { data: { user, token } } + meta.message", function () {
    const body = res.getBody();
    expect(body.data.user).to.have.property("email");
    expect(body.data.token).to.be.a("string");
    expect(body.meta.message).to.equal("Login successful");
  });
}
