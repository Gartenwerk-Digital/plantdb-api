meta {
  name: list genera
  type: http
  seq: 1
}

get {
  url: {{apiUrl}}/genera
  auth: none
}

params:query {
  ~filter[name]:
  ~sort: name
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    if (Array.isArray(data) && data.length > 0 && data[0].id) {
      bru.setEnvVar("genusId", data[0].id);
    }
  }
}
