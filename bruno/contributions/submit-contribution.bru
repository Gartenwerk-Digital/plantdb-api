meta {
  name: submit contribution
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/contributions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "new_plant",
    "payload": {
      "scientific_name": "Solanum lycopersicum 'San Marzano'",
      "common_name": "San Marzano Tomate",
      "family_id": "{{familyId}}",
      "genus_id": "{{genusId}}"
    }
  }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns contribution id and pending status", function () {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.status).to.equal("pending");
    expect(body.data.type).to.equal("new_plant");
  });
}

docs {
  Requires familyId and genusId env vars.
  Run "list families" and "list genera" once — their post-response
  scripts populate the vars automatically.
}
