meta {
  name: not found (error envelope demo)
  type: http
  seq: 2
}

get {
  url: {{apiUrl}}/does-not-exist
  auth: none
}

tests {
  test("responds 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("returns unified error envelope", function () {
    const body = res.getBody();
    expect(body).to.have.property("error");
    expect(body.error.code).to.equal("not_found");
    expect(body.error).to.have.property("message");
  });
}
