meta {
  name: rate-limit exceeded (429 demo)
  type: http
  seq: 4
}

get {
  url: {{apiUrl}}/me
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Simulate the daily limit by exhausting the token's counter in tinker before
  running this request:

  php artisan tinker
  > RateLimiter::hit(md5('apitoken:'.<TOKEN_ID>), 86400)  // repeat for the tier's ceiling

  The response then returns 429 with the unified error envelope,
  code `too_many_requests`, and a `Retry-After` header (seconds until reset).
}

tests {
  // These assertions only run once you've exhausted the token's daily
  // counter via the tinker snippet above. On a fresh token the endpoint
  // simply returns 200 and the tests are skipped.
  test("if throttled, response is a well-formed 429", function () {
    if (res.getStatus() !== 429) {
      return;
    }
    const body = res.getBody();
    expect(body.error.code).to.equal("too_many_requests");
    expect(res.getHeader("retry-after")).to.not.be.undefined;
  });
}
